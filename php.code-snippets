  "Ham Giai Phuong Trinh Bac 2 (ax^2 + bx + c = 0)": {
    "scope": "php,html",
    "prefix": [
      "!giaiphuongtrinhbac2_delta",
      "!ptb2",
      "phpptb2"
    ],
    "body": [
      "<?php",
      "if (!function_exists('giaiPTB2')) {",
      "\tfunction giaiPTB2(\\$a, \\$b, \\$c) {",
      "\t\tif (\\$a == 0) {",
      "\t\t\tif (\\$b == 0) return (\\$c == 0) ? 'Vô số nghiệm' : 'Vô nghiệm';",
      "\t\t\treturn 'Phương trình có 1 nghiệm x = ' . (-\\$c / \\$b);",
      "\t\t}",
      "\t\t\\$delta = \\$b * \\$b - 4 * \\$a * \\$c;",
      "\t\tif (\\$delta < 0) return 'Phương trình vô nghiệm';",
      "\t\tif (\\$delta == 0) return 'Nghiệm kép x1 = x2 = ' . (-\\$b / (2 * \\$a));",
      "\t\t\\$x1 = (-\\$b + sqrt(\\$delta)) / (2 * \\$a);",
      "\t\t\\$x2 = (-\\$b - sqrt(\\$delta)) / (2 * \\$a);",
      "\t\treturn \"2 nghiệm phân biệt: x1 = \\$x1, x2 = \\$x2\";",
      "\t}",
      "}",
      "?>"
    ],
    "description": "Ham giaiPTB2($a, $b, $c) giai phuong trinh bac 2"
  },
  "Ham Kiem Tra So Nguyen To Va Xuat N So Nguyen To Dau Tien": {
    "scope": "php,html",
    "prefix": [
      "!kiemtrasonguyento_xuatnsonguyento",
      "!songuyento",
      "phpprime"
    ],
    "body": [
      "<?php",
      "if (!function_exists('kiemTraNguyenTo')) {",
      "\tfunction kiemTraNguyenTo(\\$x) {",
      "\t\tif (\\$x < 2) return false;",
      "\t\tfor (\\$i = 2; \\$i <= sqrt(\\$x); \\$i++) {",
      "\t\t\tif (\\$x % \\$i === 0) return false;",
      "\t\t}",
      "\t\treturn true;",
      "\t}",
      "\tfunction xuatNSoNguyenTo(\\$n) {",
      "\t\t\\$dem = 0; \\$so = 2; \\$kq = array();",
      "\t\twhile (\\$dem < \\$n) {",
      "\t\t\tif (kiemTraNguyenTo(\\$so)) { \\$kq[] = \\$so; \\$dem++; }",
      "\t\t\t\\$so++;",
      "\t\t}",
      "\t\treturn implode(', ', \\$kq);",
      "\t}",
      "}",
      "?>"
    ],
    "description": "Ham kiemTraNguyenTo($x) va xuatNSoNguyenTo($n)"
  },
  "Ham Tinh Tong Chu So, Tong Cac So Trong Chuoi, Doi Xung, Xoa Khoang Trang": {
    "scope": "php,html",
    "prefix": [
      "!tongchuso_tongsotrongchuoi_doixung",
      "!tongsochuoi",
      "phpstrnum"
    ],
    "body": [
      "<?php",
      "if (!function_exists('tongChuSo')) {",
      "\tfunction tongChuSo(\\$str) {",
      "\t\t\\$tong = 0;",
      "\t\t\\$str  = (string)\\$str;",
      "\t\tfor (\\$i = 0; \\$i < strlen(\\$str); \\$i++) {",
      "\t\t\tif (is_numeric(\\$str[\\$i])) \\$tong += (int)\\$str[\\$i];",
      "\t\t}",
      "\t\treturn \\$tong;",
      "\t}",
      "\tfunction tongCacSo(\\$str) {",
      "\t\tpreg_match_all('/\\\\d+/', (string)\\$str, \\$m);",
      "\t\treturn array_sum(\\$m[0] ?? array());",
      "\t}",
      "\tfunction laDoiXung(\\$str) {",
      "\t\treturn (string)\\$str === strrev((string)\\$str);",
      "\t}",
      "\tfunction xoaKhoangTrangThua(\\$str) {",
      "\t\treturn preg_replace('/\\\\s+/', ' ', trim((string)\\$str));",
      "\t}",
      "}",
      "?>"
    ],
    "description": "Ham tongChuSo, tongCacSo, laDoiXung, xoaKhoangTrangThua"
  },
