  "Lab 3 - Bai 4.4: Ham BCC($n, $colorHead, $color1, $color2) Va BanCo($size) Return Chuoi HTML": {
    "scope": "php,html",
    "prefix": [
      "!lab3_4.4",
      "!lab3_4.4_bcc_banco_return"
    ],
    "body": [
      "<?php",
      "function BCC(\\$n, \\$colorHead = \"#cccccc\", \\$color1 = \"#ffffff\", \\$color2 = \"#eeeeee\") {",
      "\t\\$html = \"<table border='1' cellpadding='5' cellspacing='0'>\";",
      "\t\\$html .= \"<tr bgcolor='\\$colorHead'><th colspan='3'>Bảng cửu chương \\$n</th></tr>\";",
      "\tfor (\\$i = 1; \\$i <= 10; \\$i++) {",
      "\t\t\\$bg = (\\$i % 2 != 0) ? \\$color1 : \\$color2;",
      "\t\t\\$html .= \"<tr bgcolor='\\$bg'><td>\\$n</td><td>\\$i</td><td>\" . (\\$n * \\$i) . \"</td></tr>\";",
      "\t}",
      "\t\\$html .= \"</table>\";",
      "\treturn \\$html;",
      "}",
      "",
      "function BanCo(\\$size = 8) {",
      "\t\\$html = \"<table border='1' cellspacing='0' cellpadding='0'>\";",
      "\tfor (\\$i = 1; \\$i <= \\$size; \\$i++) {",
      "\t\t\\$html .= \"<tr>\";",
      "\t\tfor (\\$j = 1; \\$j <= \\$size; \\$j++) {",
      "\t\t\t\\$bg   = ((\\$i + \\$j) % 2 == 0) ? \"#ffffff\" : \"#000000\";",
      "\t\t\t\\$text = ((\\$i + \\$j) % 2 == 0) ? \"#000000\" : \"#ffffff\";",
      "\t\t\t\\$html .= \"<td width='45' height='45' bgcolor='\\$bg' style='color:\\$text;text-align:center;'>\\$i-\\$j</td>\";",
      "\t\t}",
      "\t\t\\$html .= \"</tr>\";",
      "\t}",
      "\t\\$html .= \"</table>\";",
      "\treturn \\$html;",
      "}",
      "",
      "echo BCC(6);",
      "echo \"<br>\";",
      "echo BanCo(8);",
      "?>"
    ],
    "description": "Lab 3 - Bài 4.4: Hàm BCC nhận $n, $colorHead, $color1, $color2 (dòng đầu, dòng lẻ, dòng chẵn) và BanCo($size) trả về chuỗi HTML"
  },
