  "Lab 2 - Bai 5.3: Giai Phuong Trinh Bac 2 (ax^2 + bx + c = 0)": {
    "scope": "php,html",
    "prefix": [
      "!lab2_5.3",
      "!lab2_5.3_phuongtrinh_bac2"
    ],
    "body": [
      "<?php",
      "\\$a = 1;",
      "\\$b = -5;",
      "\\$c = 6;",
      "",
      "if (\\$a == 0) {",
      "\tif (\\$b == 0) {",
      "\t\techo \\$c == 0 ? \"Phương trình vô số nghiệm\" : \"Phương trình vô nghiệm\";",
      "\t} else {",
      "\t\techo \"Phương trình có 1 nghiệm x = \" . (-\\$c / \\$b);",
      "\t}",
      "} else {",
      "\t\\$delta = \\$b * \\$b - 4 * \\$a * \\$c;",
      "\tif (\\$delta < 0) {",
      "\t\techo \"Phương trình vô nghiệm\";",
      "\t} elseif (\\$delta == 0) {",
      "\t\techo \"Phương trình có nghiệm kép x1 = x2 = \" . (-\\$b / (2 * \\$a));",
      "\t} else {",
      "\t\t\\$x1 = (-\\$b + sqrt(\\$delta)) / (2 * \\$a);",
      "\t\t\\$x2 = (-\\$b - sqrt(\\$delta)) / (2 * \\$a);",
      "\t\techo \"Phương trình có 2 nghiệm phân biệt: x1 = \\$x1, x2 = \\$x2\";",
      "\t}",
      "}",
      "?>"
    ],
    "description": "Lab 2 - Bài 5.3: Giải phương trình bậc 2 ax^2 + bx + c = 0 đầy đủ các trường hợp"
  },
