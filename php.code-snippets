  "Lab 3 - Bai 5.2: Ham Kiem Tra Chuoi Doi Xung (Palindrome)": {
    "scope": "php,html",
    "prefix": [
      "!lab3_5.2",
      "!lab3_5.2_chuoi_doixung"
    ],
    "body": [
      "<?php",
      "function kiemTraDoiXung(\\$s) {",
      "\t\\$len = strlen(\\$s);",
      "\tfor (\\$i = 0; \\$i < (int)(\\$len / 2); \\$i++) {",
      "\t\tif (\\$s[\\$i] !== \\$s[\\$len - 1 - \\$i]) {",
      "\t\t\treturn false;",
      "\t\t}",
      "\t}",
      "\treturn true;",
      "}",
      "",
      "\\$s = \"abcba\";",
      "echo kiemTraDoiXung(\\$s) ? \"\\$s là chuỗi đối xứng\" : \"\\$s là chuỗi không đối xứng\";",
      "?>"
